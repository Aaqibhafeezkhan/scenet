{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "scenet",
          "version": "0.10.0",
          "informationUri": "https://github.com/creatoan/scenet",
          "rules": [
            {
              "id": "scenet/duplicate-panel",
              "name": "duplicate-panel",
              "shortDescription": {
                "text": "Two panels in a comic script have the same name"
              },
              "fullDescription": {
                "text": "Panels are named by their PANEL heading, and by their PAGE heading as well when panel numbers start again on each page. Two panels that still share a name -- PANEL 1 twice on one page, or twice with no PAGE heading between them -- cannot both be kept, and dropping one without a word would lose whatever it held."
              },
              "help": {
                "text": "Number the panels straight through, or put a PAGE heading before each page whose numbering starts again."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "scenet/syntax",
              "name": "syntax",
              "shortDescription": {
                "text": "The document is not valid YAML"
              },
              "fullDescription": {
                "text": "The file could not be parsed at all, so nothing further could be checked. Usually an unclosed bracket or quote, or a line indented inconsistently with the ones around it."
              },
              "help": {
                "text": "Fix the reported position; YAML errors cascade, so re-check after each fix."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "scenet/unknown-actor",
              "name": "unknown-actor",
              "shortDescription": {
                "text": "Reference to an actor that is not in the cast"
              },
              "fullDescription": {
                "text": "Every actor id named in `staging` or `script` must exist in `cast`. This is the check no JSON Schema can perform -- the value is a perfectly good string, it just does not resolve -- and it is among the most common faults in generated documents."
              },
              "help": {
                "text": "Correct the id, or add the actor to `cast`. The message lists the cast."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "columnKind": "unicodeCodePoints",
      "results": [
        {
          "ruleId": "scenet/unknown-actor",
          "ruleIndex": 2,
          "level": "error",
          "message": {
            "text": "script entry 0 is spoken by unknown actor 'bpb'; cast is ['alice', 'bob']"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "sources/unknown-actor.panel.yaml"
                },
                "region": {
                  "startLine": 4,
                  "startColumn": 15,
                  "endLine": 4,
                  "endColumn": 18
                }
              }
            }
          ],
          "partialFingerprints": {
            "scenetDiagnostic/v1": "a9575d474eb3b0369c2a7bbe5ff035fb"
          }
        },
        {
          "ruleId": "scenet/duplicate-panel",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "line 10: PANEL 1 appears twice on page 1; the first is on line 6. Number panels straight through, or start each page with a PAGE heading"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "sources/duplicate-panel.script"
                },
                "region": {
                  "startLine": 10,
                  "startColumn": 1,
                  "endLine": 10,
                  "endColumn": 8
                }
              }
            }
          ],
          "partialFingerprints": {
            "scenetDiagnostic/v1": "d3ee0ecf84e84780051232d34f577665"
          }
        },
        {
          "ruleId": "scenet/syntax",
          "ruleIndex": 1,
          "level": "error",
          "message": {
            "text": "invalid YAML: while parsing a flow sequence\n  in \"<unicode string>\", line 3, column 10:\n    staging: [alice left_of\n             ^\nexpected ',' or ']', but got '<stream end>'\n  in \"<unicode string>\", line 4, column 1:\n    \n    ^"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "sources/syntax.panel.yaml"
                },
                "region": {
                  "startLine": 3,
                  "startColumn": 24,
                  "endLine": 3,
                  "endColumn": 25
                }
              }
            }
          ],
          "partialFingerprints": {
            "scenetDiagnostic/v1": "93841ed776ea27c5812196499b1fc38b"
          }
        }
      ]
    }
  ]
}
