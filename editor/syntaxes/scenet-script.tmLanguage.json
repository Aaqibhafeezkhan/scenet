{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Scenet comic script",
  "scopeName": "source.scenet-script",
  "comment": "Generated from scenet-script.grammar.ts by `npm run grammar`: edit that, not this. Follows the script frontend (src/scenet/frontends/script_front.py) line for line, as the playground's Monarch tokenizer does. Both are tested against tests/script_highlighting/, which tests/test_script_highlighting.py holds to the frontend. Each pattern is the frontend's, with the leading whitespace it strips made explicit.",
  "patterns": [
    {
      "include": "#preamble"
    },
    {
      "include": "#body"
    }
  ],
  "repository": {
    "preamble": {
      "comment": "Blank lines before anything else, where front matter may open. Begins only on a first line that is blank or a fence, and ends at the first other non-blank line, so a later --- is prose.",
      "begin": "\\A(?=[ \\t\\x{00A0}\\x{202F}]*(?:---[ \\t\\x{00A0}\\x{202F}]*)?$)",
      "end": "^(?=[ \\t\\x{00A0}\\x{202F}]*\\S)(?![ \\t\\x{00A0}\\x{202F}]*---[ \\t\\x{00A0}\\x{202F}]*$)",
      "patterns": [
        {
          "include": "#front-matter"
        }
      ]
    },
    "front-matter": {
      "name": "meta.frontmatter.scenet-script",
      "contentName": "meta.embedded.block.frontmatter",
      "begin": "^[ \\t\\x{00A0}\\x{202F}]*(---)[ \\t\\x{00A0}\\x{202F}]*$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.separator.frontmatter.scenet-script"
        }
      },
      "end": "^(---)[ \\t\\x{00A0}\\x{202F}]*$",
      "endCaptures": {
        "1": {
          "name": "punctuation.separator.frontmatter.scenet-script"
        }
      },
      "patterns": [
        {
          "include": "source.yaml"
        }
      ]
    },
    "body": {
      "patterns": [
        {
          "include": "#rule"
        },
        {
          "include": "#page"
        },
        {
          "include": "#panel"
        },
        {
          "include": "#directive"
        },
        {
          "include": "#caption"
        },
        {
          "include": "#sfx"
        },
        {
          "include": "#inline-speech"
        },
        {
          "include": "#speech"
        },
        {
          "include": "#prose"
        }
      ]
    },
    "rule": {
      "comment": "A Markdown horizontal rule, which the frontend reads as the blank line it looks like.",
      "match": "^[ \\t\\x{00A0}\\x{202F}]*(-(?:[ \\t\\x{00A0}\\x{202F}]*-){2,}|\\*(?:[ \\t\\x{00A0}\\x{202F}]*\\*){2,}|_(?:[ \\t\\x{00A0}\\x{202F}]*_){2,})[ \\t\\x{00A0}\\x{202F}]*$",
      "captures": {
        "1": {
          "name": "punctuation.definition.markdown.scenet-script"
        }
      }
    },
    "page": {
      "match": "^[ \\t\\x{00A0}\\x{202F}]*((?:#{1,6}[ \\t\\x{00A0}\\x{202F}]+)?(?:\\*\\*|__)?)((?i:page|planche))[ \\t\\x{00A0}\\x{202F}]+((?i:(?:twenty|thirty|forty|fifty|sixty|seventy|eighty|ninety)(?:[ \\t-]+(?:one|two|three|four|five|six|seven|eight|nine))?|zero|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen)(?=[ \\t\\x{00A0}\\x{202F}]*(?:\\(|[.:*_]|$))|[^\\s:()]+?)[ \\t\\x{00A0}\\x{202F}]*(?:(\\()([^)]*)(\\)))?[ \\t\\x{00A0}\\x{202F}]*([.:]?)[ \\t\\x{00A0}\\x{202F}]*((?:\\*\\*|__)?)[ \\t\\x{00A0}\\x{202F}]*$",
      "captures": {
        "1": {
          "name": "punctuation.definition.markdown.scenet-script"
        },
        "2": {
          "name": "keyword.control.page.scenet-script"
        },
        "3": {
          "name": "entity.name.section.page.scenet-script"
        },
        "4": {
          "name": "punctuation.definition.page-count.begin.scenet-script"
        },
        "5": {
          "name": "markup.italic.page-count.scenet-script"
        },
        "6": {
          "name": "punctuation.definition.page-count.end.scenet-script"
        },
        "7": {
          "name": "punctuation.separator.scenet-script"
        },
        "8": {
          "name": "punctuation.definition.markdown.scenet-script"
        }
      }
    },
    "panel": {
      "comment": "`PANEL 1` alone, or Dark Horse's `Panel 1. Alice and Bob on a corner.`",
      "patterns": [
        {
          "match": "^[ \\t\\x{00A0}\\x{202F}]*((?:#{1,6}[ \\t\\x{00A0}\\x{202F}]+)?(?:\\*\\*|__)?)((?i:panel))[ \\t\\x{00A0}\\x{202F}]+([^\\s:]+?)[ \\t\\x{00A0}\\x{202F}]*([.:]?)[ \\t\\x{00A0}\\x{202F}]*((?:\\*\\*|__)?)[ \\t\\x{00A0}\\x{202F}]*$",
          "captures": {
            "1": {
              "name": "punctuation.definition.markdown.scenet-script"
            },
            "2": {
              "name": "keyword.control.panel.scenet-script"
            },
            "3": {
              "name": "entity.name.section.panel.scenet-script"
            },
            "4": {
              "name": "punctuation.separator.scenet-script"
            },
            "5": {
              "name": "punctuation.definition.markdown.scenet-script"
            }
          }
        },
        {
          "match": "^[ \\t\\x{00A0}\\x{202F}]*((?:#{1,6}[ \\t\\x{00A0}\\x{202F}]+)?(?:\\*\\*|__)?)((?i:case|vignette))[ \\t\\x{00A0}\\x{202F}]+((?:\\d+\\p{L}?|(?i:twenty|thirty|forty|fifty|sixty|seventy|eighty|ninety|zero|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen|z[eé]ro|une?|deux|trois|quatre|cinq|six|sept|huit|neuf|dix|onze|douze|treize|quatorze|quinze|seize|vingt)(?!\\p{L})|\\p{L}(?!\\p{L})))[ \\t\\x{00A0}\\x{202F}]*([.:]?)[ \\t\\x{00A0}\\x{202F}]*((?:\\*\\*|__)?)[ \\t\\x{00A0}\\x{202F}]*$",
          "captures": {
            "1": {
              "name": "punctuation.definition.markdown.scenet-script"
            },
            "2": {
              "name": "keyword.control.panel.scenet-script"
            },
            "3": {
              "name": "entity.name.section.panel.scenet-script"
            },
            "4": {
              "name": "punctuation.separator.scenet-script"
            },
            "5": {
              "name": "punctuation.definition.markdown.scenet-script"
            }
          }
        },
        {
          "match": "^[ \\t\\x{00A0}\\x{202F}]*((?:#{1,6}[ \\t\\x{00A0}\\x{202F}]+)?(?:\\*\\*|__)?)((?i:panel|case|vignette))[ \\t\\x{00A0}\\x{202F}]+((?:\\d+\\p{L}?|(?i:twenty|thirty|forty|fifty|sixty|seventy|eighty|ninety|zero|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen|z[eé]ro|une?|deux|trois|quatre|cinq|six|sept|huit|neuf|dix|onze|douze|treize|quatorze|quinze|seize|vingt)(?!\\p{L})|\\p{L}(?!\\p{L})))[ \\t\\x{00A0}\\x{202F}]*([.:—–]|[ \\t\\x{00A0}\\x{202F}]-)[ \\t\\x{00A0}\\x{202F}]*(\\S.*)$",
          "captures": {
            "1": {
              "name": "punctuation.definition.markdown.scenet-script"
            },
            "2": {
              "name": "keyword.control.panel.scenet-script"
            },
            "3": {
              "name": "entity.name.section.panel.scenet-script"
            },
            "4": {
              "name": "punctuation.separator.scenet-script"
            },
            "5": {
              "name": "comment.line.prose.scenet-script"
            }
          }
        }
      ]
    },
    "directive": {
      "match": "^[ \\t\\x{00A0}\\x{202F}]*(@)(\\w+)[ \\t\\x{00A0}\\x{202F}]*(:)[ \\t\\x{00A0}\\x{202F}]*(.+)$",
      "captures": {
        "1": {
          "name": "punctuation.definition.directive.scenet-script"
        },
        "2": {
          "name": "entity.other.attribute-name.directive.scenet-script"
        },
        "3": {
          "name": "punctuation.separator.key-value.scenet-script"
        },
        "4": {
          "name": "string.unquoted.directive.scenet-script"
        }
      }
    },
    "caption": {
      "comment": "A caption: `CAP: Later.` with its text on the line, or `CAP:`, `CAPTION` or Dark Horse's `CAP/ALICE` with the text on the lines under it. Checked before cues, as the compiler checks it.",
      "patterns": [
        {
          "include": "#caption-line"
        },
        {
          "include": "#caption-block"
        }
      ]
    },
    "caption-line": {
      "match": "^[ \\t\\x{00A0}\\x{202F}]*(\\d+[.)]?[ \\t\\x{00A0}\\x{202F}]+)?((?:\\*\\*|__)?)((?i:caption|cap|r[eé]citatif|narratif|cartouche)(?![\\p{L}\\p{N}_]))[ \\t\\x{00A0}\\x{202F}]*(?:(/)[ \\t\\x{00A0}\\x{202F}]*([^():/]+?)[ \\t\\x{00A0}\\x{202F}]*)?(?:(\\()([^)]*(?:\\)[ \\t\\x{00A0}\\x{202F}]*\\([^)]*)*)(\\)))?[ \\t\\x{00A0}\\x{202F}]*(:)((?:\\*\\*|__)?)[ \\t\\x{00A0}\\x{202F}]*(\\S.*)$",
      "captures": {
        "1": {
          "name": "constant.numeric.balloon-number.scenet-script"
        },
        "2": {
          "name": "punctuation.definition.markdown.scenet-script"
        },
        "3": {
          "name": "keyword.other.caption.scenet-script"
        },
        "4": {
          "name": "punctuation.separator.scenet-script"
        },
        "5": {
          "name": "entity.name.type.caption-speaker.scenet-script"
        },
        "6": {
          "name": "punctuation.definition.caption-kind.begin.scenet-script"
        },
        "7": {
          "name": "markup.italic.caption-kind.scenet-script"
        },
        "8": {
          "name": "punctuation.definition.caption-kind.end.scenet-script"
        },
        "9": {
          "name": "punctuation.separator.scenet-script"
        },
        "10": {
          "name": "punctuation.definition.markdown.scenet-script"
        },
        "11": {
          "name": "string.unquoted.caption.scenet-script"
        }
      }
    },
    "caption-block": {
      "name": "meta.caption.scenet-script",
      "begin": "^[ \\t\\x{00A0}\\x{202F}]*(\\d+[.)]?[ \\t\\x{00A0}\\x{202F}]+)?((?:\\*\\*|__)?)((?i:caption|cap|r[eé]citatif|narratif|cartouche)(?![\\p{L}\\p{N}_]))[ \\t\\x{00A0}\\x{202F}]*(?:(/)[ \\t\\x{00A0}\\x{202F}]*([^():/]+?)[ \\t\\x{00A0}\\x{202F}]*)?(?:(\\()([^)]*(?:\\)[ \\t\\x{00A0}\\x{202F}]*\\([^)]*)*)(\\)))?[ \\t\\x{00A0}\\x{202F}]*(:?)((?:\\*\\*|__)?)[ \\t\\x{00A0}\\x{202F}]*$",
      "beginCaptures": {
        "1": {
          "name": "constant.numeric.balloon-number.scenet-script"
        },
        "2": {
          "name": "punctuation.definition.markdown.scenet-script"
        },
        "3": {
          "name": "keyword.other.caption.scenet-script"
        },
        "4": {
          "name": "punctuation.separator.scenet-script"
        },
        "5": {
          "name": "entity.name.type.caption-speaker.scenet-script"
        },
        "6": {
          "name": "punctuation.definition.caption-kind.begin.scenet-script"
        },
        "7": {
          "name": "markup.italic.caption-kind.scenet-script"
        },
        "8": {
          "name": "punctuation.definition.caption-kind.end.scenet-script"
        },
        "9": {
          "name": "punctuation.separator.scenet-script"
        },
        "10": {
          "name": "punctuation.definition.markdown.scenet-script"
        }
      },
      "end": "^(?=[ \\t\\x{00A0}\\x{202F}]*$|[ \\t\\x{00A0}\\x{202F}]*(?:-(?:[ \\t\\x{00A0}\\x{202F}]*-){2,}|\\*(?:[ \\t\\x{00A0}\\x{202F}]*\\*){2,}|_(?:[ \\t\\x{00A0}\\x{202F}]*_){2,})[ \\t\\x{00A0}\\x{202F}]*$|[ \\t\\x{00A0}\\x{202F}]*(?:#{1,6}[ \\t\\x{00A0}\\x{202F}]+)?(?:\\*\\*|__)?(?i:page|planche)[ \\t\\x{00A0}\\x{202F}]+(?:(?i:(?:twenty|thirty|forty|fifty|sixty|seventy|eighty|ninety)(?:[ \\t-]+(?:one|two|three|four|five|six|seven|eight|nine))?|zero|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen)(?=[ \\t\\x{00A0}\\x{202F}]*(?:\\(|[.:*_]|$))|[^\\s:()]+?)[ \\t\\x{00A0}\\x{202F}]*(?:\\([^)]*\\))?[ \\t\\x{00A0}\\x{202F}]*[.:]?[ \\t\\x{00A0}\\x{202F}]*(?:\\*\\*|__)?[ \\t\\x{00A0}\\x{202F}]*$|[ \\t\\x{00A0}\\x{202F}]*(?:#{1,6}[ \\t\\x{00A0}\\x{202F}]+)?(?:\\*\\*|__)?(?i:panel)[ \\t\\x{00A0}\\x{202F}]+[^\\s:]+?[ \\t\\x{00A0}\\x{202F}]*[.:]?[ \\t\\x{00A0}\\x{202F}]*(?:\\*\\*|__)?[ \\t\\x{00A0}\\x{202F}]*$|[ \\t\\x{00A0}\\x{202F}]*(?:#{1,6}[ \\t\\x{00A0}\\x{202F}]+)?(?:\\*\\*|__)?(?i:case|vignette)[ \\t\\x{00A0}\\x{202F}]+(?:\\d+\\p{L}?|(?i:twenty|thirty|forty|fifty|sixty|seventy|eighty|ninety|zero|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen|z[eé]ro|une?|deux|trois|quatre|cinq|six|sept|huit|neuf|dix|onze|douze|treize|quatorze|quinze|seize|vingt)(?!\\p{L})|\\p{L}(?!\\p{L}))[ \\t\\x{00A0}\\x{202F}]*[.:]?[ \\t\\x{00A0}\\x{202F}]*(?:\\*\\*|__)?[ \\t\\x{00A0}\\x{202F}]*$|[ \\t\\x{00A0}\\x{202F}]*(?:#{1,6}[ \\t\\x{00A0}\\x{202F}]+)?(?:\\*\\*|__)?(?i:panel|case|vignette)[ \\t\\x{00A0}\\x{202F}]+(?:\\d+\\p{L}?|(?i:twenty|thirty|forty|fifty|sixty|seventy|eighty|ninety|zero|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen|z[eé]ro|une?|deux|trois|quatre|cinq|six|sept|huit|neuf|dix|onze|douze|treize|quatorze|quinze|seize|vingt)(?!\\p{L})|\\p{L}(?!\\p{L}))[ \\t\\x{00A0}\\x{202F}]*(?:[.:—–]|[ \\t\\x{00A0}\\x{202F}]-)[ \\t\\x{00A0}\\x{202F}]*\\S|[ \\t\\x{00A0}\\x{202F}]*(?:\\d+[.)]?[ \\t\\x{00A0}\\x{202F}]+)?(?:\\*\\*|__)?(?i:caption|cap|r[eé]citatif|narratif|cartouche)(?![\\p{L}\\p{N}_])[ \\t\\x{00A0}\\x{202F}]*(?:/[ \\t\\x{00A0}\\x{202F}]*[^():/]+?[ \\t\\x{00A0}\\x{202F}]*)?(?:\\([^)]*\\)[ \\t\\x{00A0}\\x{202F}]*)*[ \\t\\x{00A0}\\x{202F}]*:(?:\\*\\*|__)?[ \\t\\x{00A0}\\x{202F}]*\\S|[ \\t\\x{00A0}\\x{202F}]*(?:\\d+[.)]?[ \\t\\x{00A0}\\x{202F}]+)?(?:\\*\\*|__)?(?i:caption|cap|r[eé]citatif|narratif|cartouche)(?![\\p{L}\\p{N}_])[ \\t\\x{00A0}\\x{202F}]*(?:/[ \\t\\x{00A0}\\x{202F}]*[^():/]+?[ \\t\\x{00A0}\\x{202F}]*)?(?:\\([^)]*\\)[ \\t\\x{00A0}\\x{202F}]*)*[ \\t\\x{00A0}\\x{202F}]*:?(?:\\*\\*|__)?[ \\t\\x{00A0}\\x{202F}]*$|[ \\t\\x{00A0}\\x{202F}]*(?:\\d+[.)]?[ \\t\\x{00A0}\\x{202F}]+)?(?i:sfx|onomatop[eé]e)[ \\t\\x{00A0}\\x{202F}]*(?:\\([^)]*\\))?[ \\t\\x{00A0}\\x{202F}]*:[ \\t\\x{00A0}\\x{202F}]*\\S|[ \\t\\x{00A0}\\x{202F}]*(?:\\d+[.)]?[ \\t\\x{00A0}\\x{202F}]+)?(?i:sfx|onomatop[eé]e)[ \\t\\x{00A0}\\x{202F}]*(?:\\([^)]*\\))?[ \\t\\x{00A0}\\x{202F}]*:?[ \\t\\x{00A0}\\x{202F}]*$|[ \\t\\x{00A0}\\x{202F}]*(?:\\d+[.)]?[ \\t\\x{00A0}\\x{202F}]+)?(?:\\*\\*|__)?\\p{Lu}[\\p{Lu}\\p{M}\\p{Nd} _'.\\-]*?[ \\t\\x{00A0}\\x{202F}]*(?:\\([^)]*\\)[ \\t\\x{00A0}\\x{202F}]*)*[ \\t\\x{00A0}\\x{202F}]*:(?:\\*\\*|__)?[ \\t\\x{00A0}\\x{202F}]*\\S|[ \\t\\x{00A0}\\x{202F}]*@\\w+[ \\t\\x{00A0}\\x{202F}]*:[ \\t\\x{00A0}\\x{202F}]*\\S|[ \\t\\x{00A0}\\x{202F}]*(?:\\d+[.)]?[ \\t\\x{00A0}\\x{202F}]+)?(?=\\S(?:.{0,38}\\S)?[ \\t\\x{00A0}\\x{202F}]*$)\\p{Lu}[\\p{Lu}\\p{M}\\p{Nd} _'.\\-]*?[ \\t\\x{00A0}\\x{202F}]*(?:\\([^)]*\\)[ \\t\\x{00A0}\\x{202F}]*)*[ \\t\\x{00A0}\\x{202F}]*:?[ \\t\\x{00A0}\\x{202F}]*$)",
      "patterns": [
        {
          "include": "#caption-pending"
        },
        {
          "match": "^[ \\t\\x{00A0}\\x{202F}]*(\\S.*)$",
          "captures": {
            "1": {
              "name": "string.unquoted.caption.scenet-script"
            }
          }
        }
      ]
    },
    "caption-pending": {
      "comment": "The first line under a caption label is its text, whatever it looks like.",
