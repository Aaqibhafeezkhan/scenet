{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Scenet comic script",
  "scopeName": "source.scenet-script",
  "comment": "Generated from scenet-script.grammar.ts by `npm run grammar`: edit that, not this. Follows the script frontend (src/scenet/frontends/script_front.py) line for line, as the playground's Monarch tokenizer does. Both are tested against tests/script_highlighting/, which tests/test_script_highlighting.py holds to the frontend. Each pattern is the frontend's, with the leading whitespace it strips made explicit.",
  "patterns": [
    {
      "include": "#preamble"
    },
    {
      "include": "#body"
    }
  ],
  "repository": {
    "preamble": {
      "comment": "Blank lines before anything else, where front matter may open. Begins only on a first line that is blank or a fence, and ends at the first other non-blank line, so a later --- is prose.",
      "begin": "\\A(?=[ \\t]*(?:---[ \\t]*)?$)",
      "end": "^(?=[ \\t]*\\S)(?![ \\t]*---[ \\t]*$)",
      "patterns": [
        {
          "include": "#front-matter"
        }
      ]
    },
    "front-matter": {
      "name": "meta.frontmatter.scenet-script",
      "contentName": "meta.embedded.block.frontmatter",
      "begin": "^[ \\t]*(---)[ \\t]*$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.separator.frontmatter.scenet-script"
        }
      },
      "end": "^(---)[ \\t]*$",
      "endCaptures": {
        "1": {
          "name": "punctuation.separator.frontmatter.scenet-script"
        }
      },
      "patterns": [
        {
          "include": "source.yaml"
        }
      ]
    },
    "body": {
      "patterns": [
        {
          "include": "#rule"
        },
        {
          "include": "#page"
        },
        {
          "include": "#panel"
        },
        {
          "include": "#directive"
        },
        {
          "include": "#caption"
        },
        {
          "include": "#sfx"
        },
        {
          "include": "#speech"
        },
        {
          "include": "#prose"
        }
      ]
    },
    "rule": {
      "comment": "A Markdown horizontal rule, which the frontend reads as the blank line it looks like.",
      "match": "^[ \\t]*(-(?:[ \\t]*-){2,}|\\*(?:[ \\t]*\\*){2,}|_(?:[ \\t]*_){2,})[ \\t]*$",
      "captures": {
        "1": {
          "name": "punctuation.definition.markdown.scenet-script"
        }
      }
    },
    "page": {
      "match": "^[ \\t]*((?:#{1,6}[ \\t]+)?(?:\\*\\*|__)?)((?i:page))[ \\t]+((?i:(?:twenty|thirty|forty|fifty|sixty|seventy|eighty|ninety)(?:[ \\t-]+(?:one|two|three|four|five|six|seven|eight|nine))?|zero|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen)(?=[ \\t]*(?:\\(|[.:*_]|$))|[^\\s:()]+?)[ \\t]*(?:(\\()([^)]*)(\\)))?[ \\t]*([.:]?)[ \\t]*((?:\\*\\*|__)?)[ \\t]*$",
      "captures": {
        "1": {
          "name": "punctuation.definition.markdown.scenet-script"
        },
        "2": {
          "name": "keyword.control.page.scenet-script"
        },
        "3": {
          "name": "entity.name.section.page.scenet-script"
        },
        "4": {
          "name": "punctuation.definition.page-count.begin.scenet-script"
        },
        "5": {
          "name": "markup.italic.page-count.scenet-script"
        },
        "6": {
          "name": "punctuation.definition.page-count.end.scenet-script"
        },
        "7": {
          "name": "punctuation.separator.scenet-script"
        },
        "8": {
          "name": "punctuation.definition.markdown.scenet-script"
        }
      }
    },
    "panel": {
      "comment": "`PANEL 1` alone, or Dark Horse's `Panel 1. Alice and Bob on a corner.`",
      "patterns": [
        {
          "match": "^[ \\t]*((?:#{1,6}[ \\t]+)?(?:\\*\\*|__)?)((?i:panel))[ \\t]+([^\\s:]+?)[ \\t]*([.:]?)[ \\t]*((?:\\*\\*|__)?)[ \\t]*$",
          "captures": {
            "1": {
              "name": "punctuation.definition.markdown.scenet-script"
            },
            "2": {
              "name": "keyword.control.panel.scenet-script"
            },
            "3": {
              "name": "entity.name.section.panel.scenet-script"
            },
            "4": {
              "name": "punctuation.separator.scenet-script"
            },
            "5": {
              "name": "punctuation.definition.markdown.scenet-script"
            }
          }
        },
        {
          "match": "^[ \\t]*((?:#{1,6}[ \\t]+)?(?:\\*\\*|__)?)((?i:panel))[ \\t]+((?:\\d+\\p{L}?|(?i:twenty|thirty|forty|fifty|sixty|seventy|eighty|ninety|zero|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen)(?!\\p{L})|\\p{L}(?!\\p{L})))[ \\t]*([.:—–]|[ \\t]-)[ \\t]*(\\S.*)$",
          "captures": {
            "1": {
              "name": "punctuation.definition.markdown.scenet-script"
            },
            "2": {
              "name": "keyword.control.panel.scenet-script"
            },
            "3": {
              "name": "entity.name.section.panel.scenet-script"
            },
            "4": {
              "name": "punctuation.separator.scenet-script"
            },
            "5": {
              "name": "comment.line.prose.scenet-script"
            }
          }
        }
      ]
    },
    "directive": {
      "match": "^[ \\t]*(@)(\\w+)[ \\t]*(:)[ \\t]*(.+)$",
      "captures": {
        "1": {
          "name": "punctuation.definition.directive.scenet-script"
        },
        "2": {
          "name": "entity.other.attribute-name.directive.scenet-script"
        },
        "3": {
          "name": "punctuation.separator.key-value.scenet-script"
        },
        "4": {
          "name": "string.unquoted.directive.scenet-script"
        }
      }
    },
    "caption": {
      "match": "^[ \\t]*((?i:caption))[ \\t]*(?:(\\()([^)]*)(\\)))?[ \\t]*(:)[ \\t]*(.+)$",
      "captures": {
        "1": {
          "name": "keyword.other.caption.scenet-script"
        },
        "2": {
          "name": "punctuation.definition.caption-kind.begin.scenet-script"
        },
        "3": {
          "name": "markup.italic.caption-kind.scenet-script"
        },
        "4": {
          "name": "punctuation.definition.caption-kind.end.scenet-script"
        },
        "5": {
          "name": "punctuation.separator.scenet-script"
        },
        "6": {
          "name": "string.unquoted.caption.scenet-script"
        }
      }
    },
    "sfx": {
      "comment": "A sound effect: `SFX: BLAM`, `SFX (BOB, large): KRAK`, or Dark Horse's bare `SFX:` cue with the sound on the next line. Checked before cues, as the compiler checks it: `SFX` is a perfectly good name in capitals.",
      "patterns": [
        {
          "include": "#sfx-line"
        },
        {
          "include": "#sfx-cue"
        }
      ]
    },
    "sfx-line": {
      "match": "^[ \\t]*((?i:sfx))[ \\t]*(?:(\\()([^)]*)(\\)))?[ \\t]*(:)[ \\t]*(.+)$",
      "captures": {
        "1": {
          "name": "keyword.other.sfx.scenet-script"
        },
        "2": {
          "name": "punctuation.definition.sfx-parenthetical.begin.scenet-script"
        },
        "3": {
          "name": "markup.italic.sfx-parenthetical.scenet-script"
        },
        "4": {
          "name": "punctuation.definition.sfx-parenthetical.end.scenet-script"
        },
        "5": {
          "name": "punctuation.separator.scenet-script"
        },
        "6": {
          "name": "string.unquoted.sfx.scenet-script"
        }
      }
    },
    "sfx-cue": {
      "comment": "The next line is the sound, whatever it looks like: `BLAM` is in capitals too.",
      "name": "meta.sfx.scenet-script",
      "begin": "^[ \\t]*((?i:sfx))[ \\t]*(?:(\\()([^)]*)(\\)))?[ \\t]*(:?)[ \\t]*$",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.sfx.scenet-script"
        },
        "2": {
          "name": "punctuation.definition.sfx-parenthetical.begin.scenet-script"
        },
        "3": {
          "name": "markup.italic.sfx-parenthetical.scenet-script"
        },
        "4": {
          "name": "punctuation.definition.sfx-parenthetical.end.scenet-script"
        },
        "5": {
          "name": "punctuation.separator.scenet-script"
        }
      },
      "end": "^(?=[ \\t]*$)|^[ \\t]*(\\S.*)$",
      "endCaptures": {
        "1": {
          "name": "string.unquoted.sfx.scenet-script"
        }
      }
    },
    "speech": {
      "comment": "A cue -- a name in capitals, an optional parenthetical and colon, at most forty characters once trimmed -- and the speech under it. The speech ends at a blank line, a heading, a caption, a directive or the next cue. Its first line is handled by #pending.",
      "name": "meta.speech.scenet-script",
      "begin": "^[ \\t]*(?=\\S(?:.{0,38}\\S)?[ \\t]*$)(\\p{Lu}[\\p{Lu}\\p{M}\\p{Nd} _'.\\-]*?)[ \\t]*(?:(\\()([^)]*)(\\)))?[ \\t]*(:?)[ \\t]*$",
      "beginCaptures": {
        "1": {
          "name": "entity.name.type.cue.scenet-script"
        },
        "2": {
          "name": "punctuation.definition.parenthetical.begin.scenet-script"
        },
        "3": {
          "name": "markup.italic.parenthetical.scenet-script"
        },
        "4": {
          "name": "punctuation.definition.parenthetical.end.scenet-script"
        },
        "5": {
          "name": "punctuation.separator.scenet-script"
        }
      },
      "end": "^(?=[ \\t]*$|[ \\t]*(?:-(?:[ \\t]*-){2,}|\\*(?:[ \\t]*\\*){2,}|_(?:[ \\t]*_){2,})[ \\t]*$|[ \\t]*(?:#{1,6}[ \\t]+)?(?:\\*\\*|__)?(?i:page)[ \\t]+(?:(?i:(?:twenty|thirty|forty|fifty|sixty|seventy|eighty|ninety)(?:[ \\t-]+(?:one|two|three|four|five|six|seven|eight|nine))?|zero|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen)(?=[ \\t]*(?:\\(|[.:*_]|$))|[^\\s:()]+?)[ \\t]*(?:\\([^)]*\\))?[ \\t]*[.:]?[ \\t]*(?:\\*\\*|__)?[ \\t]*$|[ \\t]*(?:#{1,6}[ \\t]+)?(?:\\*\\*|__)?(?i:panel)[ \\t]+[^\\s:]+?[ \\t]*[.:]?[ \\t]*(?:\\*\\*|__)?[ \\t]*$|[ \\t]*(?:#{1,6}[ \\t]+)?(?:\\*\\*|__)?(?i:panel)[ \\t]+(?:\\d+\\p{L}?|(?i:twenty|thirty|forty|fifty|sixty|seventy|eighty|ninety|zero|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen)(?!\\p{L})|\\p{L}(?!\\p{L}))[ \\t]*(?:[.:—–]|[ \\t]-)[ \\t]*\\S|[ \\t]*(?i:caption)[ \\t]*(?:\\([^)]*\\))?[ \\t]*:[ \\t]*\\S|[ \\t]*(?i:sfx)[ \\t]*(?:\\([^)]*\\))?[ \\t]*:[ \\t]*\\S|[ \\t]*(?i:sfx)[ \\t]*(?:\\([^)]*\\))?[ \\t]*:?[ \\t]*$|[ \\t]*@\\w+[ \\t]*:[ \\t]*\\S|[ \\t]*(?=\\S(?:.{0,38}\\S)?[ \\t]*$)\\p{Lu}[\\p{Lu}\\p{M}\\p{Nd} _'.\\-]*?[ \\t]*(?:\\([^)]*\\))?[ \\t]*:?[ \\t]*$)",
      "patterns": [
        {
          "include": "#pending"
        },
        {
          "match": "^[ \\t]*(\\S.*)$",
          "captures": {
            "1": {
              "name": "string.unquoted.dialogue.scenet-script"
            }
          }
        }
      ]
    },
    "pending": {
      "comment": "From the end of the cue line to the end of the first line of speech. While it is open, the speech's end is not tested, so the first line is speech whatever it looks like: `OK.` is spoken, not a cue. A directive leaves the cue waiting.",
      "begin": "\\G",
      "end": "^(?=[ \\t]*$|[ \\t]*(?:-(?:[ \\t]*-){2,}|\\*(?:[ \\t]*\\*){2,}|_(?:[ \\t]*_){2,})[ \\t]*$|[ \\t]*(?:#{1,6}[ \\t]+)?(?:\\*\\*|__)?(?i:page)[ \\t]+(?:(?i:(?:twenty|thirty|forty|fifty|sixty|seventy|eighty|ninety)(?:[ \\t-]+(?:one|two|three|four|five|six|seven|eight|nine))?|zero|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen)(?=[ \\t]*(?:\\(|[.:*_]|$))|[^\\s:()]+?)[ \\t]*(?:\\([^)]*\\))?[ \\t]*[.:]?[ \\t]*(?:\\*\\*|__)?[ \\t]*$|[ \\t]*(?:#{1,6}[ \\t]+)?(?:\\*\\*|__)?(?i:panel)[ \\t]+[^\\s:]+?[ \\t]*[.:]?[ \\t]*(?:\\*\\*|__)?[ \\t]*$|[ \\t]*(?:#{1,6}[ \\t]+)?(?:\\*\\*|__)?(?i:panel)[ \\t]+(?:\\d+\\p{L}?|(?i:twenty|thirty|forty|fifty|sixty|seventy|eighty|ninety|zero|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen)(?!\\p{L})|\\p{L}(?!\\p{L}))[ \\t]*(?:[.:—–]|[ \\t]-)[ \\t]*\\S|[ \\t]*(?i:caption)[ \\t]*(?:\\([^)]*\\))?[ \\t]*:[ \\t]*\\S|[ \\t]*(?i:sfx)[ \\t]*(?:\\([^)]*\\))?[ \\t]*:[ \\t]*\\S|[ \\t]*(?i:sfx)[ \\t]*(?:\\([^)]*\\))?[ \\t]*:?[ \\t]*$)|^[ \\t]*(?!@\\w+[ \\t]*:[ \\t]*\\S)(\\S.*)$",
      "endCaptures": {
        "1": {
          "name": "string.unquoted.dialogue.scenet-script"
        }
      },
      "patterns": [
        {
          "include": "#directive"
        }
      ]
    },
    "prose": {
      "comment": "Everything else. Preserved by the compiler, interpreted by nothing.",
      "match": "^[ \\t]*(\\S.*)$",
      "captures": {
        "1": {
          "name": "comment.line.prose.scenet-script"
        }
      }
    }
  }
}
