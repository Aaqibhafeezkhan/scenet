[["front-matter-delimiter", "---"]]
[["front-matter", "panel:"]]
[["front-matter", "size: [900, 700]"]]
[["front-matter", "cast:"]]
[["front-matter", "ALICE: {reference: alice, pose: pointing,     at: left_third}"]]
[["front-matter", "BOB:   {reference: bob,   pose: arms_crossed, at: right_third, facing: left}"]]
[["front-matter", "staging:"]]
