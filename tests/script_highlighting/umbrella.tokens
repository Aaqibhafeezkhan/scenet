[]
[["page-keyword", "PAGE"], ["page-label", "ONE"]]
[]
[["panel-keyword", "PANEL"], ["panel-label", "1"]]
[["directive-marker", "@"], ["directive-name", "shot"], ["directive-value", "full_shot"]]
[["prose", "Alice and Bob face each other on a rainy street corner. She is exasperated."]]
[]
[["cue-name", "ALICE"]]
[["dialogue", "You forgot your umbrella!"]]
[]
[["cue-name", "BOB"]]
[["dialogue", "I know."]]
[]
[["panel-keyword", "PANEL"], ["panel-label", "2"]]
[["directive-marker", "@"], ["directive-name", "shot"], ["directive-value", "medium_close_up"]]
[["prose", "Closer now. Bob will not meet her eye."]]
[]
[["cue-name", "BOB"], ["cue-parenthetical", "whisper"]]
[["dialogue", "I left it on purpose."]]
[]
[["cue-name", "ALICE"], ["cue-parenthetical", "shouting"]]
[["dialogue", "You what?!"]]
